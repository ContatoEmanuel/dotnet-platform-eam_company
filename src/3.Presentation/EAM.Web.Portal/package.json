{
  "name": "eam.web.portal",
  "version": "1.0.0",
  "description": "EAM Portal - Blazor Server Application",
  "scripts": {
    "build:ts": "tsc",
    "watch:ts": "tsc --watch",
    "build:css": "tailwindcss -i ./wwwroot/tailwind.css -o ./wwwroot/app.css --minify",
    "watch:css": "tailwindcss -i ./wwwroot/tailwind.css -o ./wwwroot/app.css --watch",
    "build": "npm run build:ts && npm run build:css",
    "watch": "npm run watch:ts & npm run watch:css"
  },
  "keywords": [
    "blazor",
    "typescript"
  ],
  "author": "EAM Solutions",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
