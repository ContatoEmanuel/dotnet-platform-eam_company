@page "/"
@layout PublicLayout
@inject IProductService ProductService
@using EAM.Web.Portal.Services

<PageTitle>EAM - Soluções para Microsoft Dynamics 365</PageTitle>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="hero-title">Extensões e Soluções para Microsoft Dynamics 365</h1>
                <p class="hero-subtitle">Potencialize seu CRM com integrações inteligentes e ferramentas desenvolvidas por especialistas</p>
                <div class="hero-actions">
                    <a href="#produtos" class="btn btn-primary btn-lg">
                        <i class="bi bi-box-seam me-2"></i>
                        Ver Produtos
                    </a>
                    <a href="/Account/Login" class="btn btn-light btn-lg">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Faça Login
                    </a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-image">
                    <i class="bi bi-microsoft" style="font-size: 15rem; color: rgba(255,255,255,0.1);"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Products Section -->
<section id="produtos" class="products-section">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="section-title">Nossos Produtos</h2>
            <p class="section-subtitle">Ferramentas desenvolvidas para otimizar seu Dynamics 365</p>
        </div>

        @if (products == null)
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in products)
                {
                    <div class="col-lg-6">
                        <div class="product-card">
                            <div class="product-icon">
                                @if (product.Name.Contains("WhatsApp"))
                                {
                                    <i class="bi bi-whatsapp"></i>
                                }
                                else
                                {
                                    <i class="bi bi-box-seam"></i>
                                }
                            </div>
                            <h3 class="product-title">@product.Name</h3>
                            <p class="product-description">@product.ShortDescription</p>
                            
                            @if (product.Technologies?.Any() == true)
                            {
                                <div class="product-features">
                                    @foreach (var tech in product.Technologies.Take(3))
                                    {
                                        <div class="feature-item">
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                            <span>@tech</span>
                                        </div>
                                    }
                                </div>
                            }
                            
                            <div class="product-footer">
                                <span class="product-price text-success">Consulte</span>
                                <a href="#contato" class="btn btn-primary">
                                    <i class="bi bi-gift me-2"></i>
                                    Teste Grátis
                                </a>
                            </div>
                        </div>
                    </div>
                }

                <!-- Placeholder if no products -->
                @if (!products.Any())
                {
                    <div class="col-lg-6">
                        <div class="product-card product-card-soon">
                            <div class="product-icon">
                                <i class="bi bi-tools"></i>
                            </div>
                            <h3 class="product-title">Novos Produtos em Breve</h3>
                            <p class="product-description">
                                Estamos desenvolvendo novas extensões e ferramentas para Dynamics 365. 
                                Fique atento às próximas novidades!
                            </p>
                            <div class="coming-soon-badge">
                                <i class="bi bi-hourglass-split"></i>
                                <span>Em desenvolvimento</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<ProjectDto>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await ProductService.GetProductsForSaleAsync();
    }
}

<style>
    /* Hero Section */
    .hero-section {
        background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%);
        color: white;
        padding: 6rem 0;
        margin: -2rem -2rem 3rem -2rem;
    }

    .hero-title {
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        line-height: 1.2;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        margin-bottom: 2rem;
        opacity: 0.9;
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .hero-image {
        text-align: center;
    }

    /* Products Section */
    .products-section {
        padding: 4rem 0;
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1rem;
    }

    .section-subtitle {
        font-size: 1.125rem;
        color: #64748b;
    }

    .product-card {
        background: white;
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: all 0.3s ease;
    }

    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
    }

    .product-card-soon {
        border: 2px dashed #cbd5e1;
        background: #f8fafc;
    }

    .product-icon {
        width: 80px;
        height: 80px;
        border-radius: 16px;
        background: linear-gradient(135deg, #3b82f6, #1e40af);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
        font-size: 2.5rem;
        color: white;
    }

    .product-card-soon .product-icon {
        background: linear-gradient(135deg, #94a3b8, #64748b);
    }

    .product-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1rem;
    }

    .product-description {
        color: #475569;
        margin-bottom: 2rem;
        flex-grow: 1;
    }

    .product-features {
        margin-bottom: 2rem;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        color: #334155;
    }

    .product-footer {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
    }

    .product-price {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
    }

    .coming-soon-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #fff;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        font-weight: 600;
        color: #64748b;
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2rem;
        }

        .hero-subtitle {
            font-size: 1rem;
        }

        .section-title {
            font-size: 2rem;
        }
    }
</style>
