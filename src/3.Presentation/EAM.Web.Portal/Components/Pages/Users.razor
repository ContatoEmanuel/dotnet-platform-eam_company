@page "/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Usuários - EAM Portal</PageTitle>

<div class="page-header mb-4">
    <h2 class="mb-1">
        <i class="bi bi-people me-2"></i>
        Usuários
    </h2>
    <p class="text-muted mb-0">Gerencie os usuários do sistema</p>
</div>

<div class="card">
    <div class="card-body text-center py-5">
        <i class="bi bi-hammer" style="font-size: 3rem; color: #94a3b8;"></i>
        <h4 class="mt-3 mb-2">Em Desenvolvimento</h4>
        <p class="text-muted">Esta funcionalidade será implementada em breve.</p>
        <a href="/" class="btn btn-primary mt-3">
            <i class="bi bi-arrow-left me-2"></i>
            Voltar ao Dashboard
        </a>
    </div>
</div>

<style>
    .page-header h2 {
        color: #1e293b;
        font-weight: 600;
    }
</style>
