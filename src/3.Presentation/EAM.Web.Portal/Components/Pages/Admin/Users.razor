@page "/admin/users"
@using Microsoft.AspNetCore.Authorization
@using EAM.Web.Portal.Services
@attribute [Authorize]
@inject IUserApiService UserApiService
@inject NavigationManager Navigation

<PageTitle>Gerenciar Usuários - EAM Solutions</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="mb-1">
                <i class="bi bi-people me-2"></i>
                Gerenciar Usuários
            </h2>
            <p class="text-muted">Visualize e gerencie as permissões dos usuários do sistema</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
            <p class="text-muted mt-3">Carregando usuários...</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>E-mail</th>
                                <th>Nome de Usuário</th>
                                <th>E-mail Confirmado</th>
                                <th>Perfil</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (users == null || !users.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        <i class="bi bi-inbox display-4 d-block mb-3"></i>
                                        Nenhum usuário encontrado
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var user in users)
                                {
                                    <tr>
                                        <td>
                                            <i class="bi bi-envelope me-2 text-muted"></i>
                                            @user.Email
                                        </td>
                                        <td>@user.UserName</td>
                                        <td>
                                            @if (user.EmailConfirmed)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>Confirmado
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">
                                                    <i class="bi bi-exclamation-circle me-1"></i>Pendente
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (userRoles.ContainsKey(user.Id))
                                            {
                                                @if (userRoles[user.Id].Contains("Admin"))
                                                {
                                                    <span class="badge bg-primary">
                                                        <i class="bi bi-shield-check me-1"></i>Administrador
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        <i class="bi bi-person me-1"></i>Usuário
                                                    </span>
                                                }
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (userRoles.ContainsKey(user.Id) && userRoles[user.Id].Contains("Admin"))
                                            {
                                                <button class="btn btn-sm btn-outline-warning" 
                                                        @onclick="() => RemoveAdminRole(user)"
                                                        disabled="@(isProcessing || adminCount <= 1)">
                                                    <i class="bi bi-arrow-down-circle me-1"></i>
                                                    Remover Admin
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-primary" 
                                                        @onclick="() => AddAdminRole(user)"
                                                        disabled="@isProcessing">
                                                    <i class="bi bi-arrow-up-circle me-1"></i>
                                                    Tornar Admin
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-people-fill text-primary display-4"></i>
                        <h5 class="mt-3">Total de Usuários</h5>
                        <h2 class="mb-0">@(users?.Count ?? 0)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-shield-check text-success display-4"></i>
                        <h5 class="mt-3">Administradores</h5>
                        <h2 class="mb-0">@adminCount</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-person text-info display-4"></i>
                        <h5 class="mt-3">Usuários Comuns</h5>
                        <h2 class="mb-0">@((users?.Count ?? 0) - adminCount)</h2>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .table thead th {
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
        font-weight: 600;
        color: #495057;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .card {
        border: none;
        border-radius: 8px;
    }

    .badge {
        padding: 0.35em 0.65em;
        font-weight: 500;
    }

    .btn-sm {
        font-size: 0.875rem;
        padding: 0.25rem 0.75rem;
    }
</style>

@code {
    private List<UserDto>? users;
    private Dictionary<string, List<string>> userRoles = new();
    private bool isLoading = true;
    private bool isProcessing = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private int adminCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            users = await UserApiService.GetAllUsersAsync();
            userRoles.Clear();
            adminCount = 0;

            foreach (var user in users)
            {
                userRoles[user.Id] = user.Roles;

                if (user.Roles.Contains("Admin"))
                {
                    adminCount++;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erro ao carregar usuários. Tente novamente.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddAdminRole(UserDto user)
    {
        isProcessing = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var success = await UserApiService.AddAdminRoleAsync(user.Id);

            if (success)
            {
                successMessage = $"Usuário {user.Email} promovido a Administrador com sucesso!";
                await LoadUsers();
                StateHasChanged();
            }
            else
            {
                errorMessage = "Erro ao promover usuário. Tente novamente.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao promover usuário: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RemoveAdminRole(UserDto user)
    {
        isProcessing = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            // Verificar se não é o último admin
            if (adminCount <= 1)
            {
                errorMessage = "Não é possível remover o último administrador do sistema.";
                isProcessing = false;
                return;
            }

            var success = await UserApiService.RemoveAdminRoleAsync(user.Id);

            if (success)
            {
                successMessage = $"Privilégios de administrador removidos de {user.Email}.";
                await LoadUsers();
                StateHasChanged();
            }
            else
            {
                errorMessage = "Erro ao remover privilégios. Tente novamente.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erro ao remover privilégios. Tente novamente.";
        }
        finally
        {
            isProcessing = false;
        }
    }
}
