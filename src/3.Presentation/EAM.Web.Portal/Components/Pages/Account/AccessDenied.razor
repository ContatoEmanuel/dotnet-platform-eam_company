@page "/Account/AccessDenied"

<PageTitle>Acesso Negado - EAM Solutions</PageTitle>

<div class="error-container">
    <div class="error-content">
        <div class="error-icon">
            <i class="bi bi-shield-x"></i>
        </div>
        <h1 class="error-title">Acesso Negado</h1>
        <p class="error-message">
            Você não tem permissão para acessar esta página.
        </p>
        <a href="/" class="btn btn-primary">
            <i class="bi bi-house me-2"></i>
            Voltar ao Dashboard
        </a>
    </div>
</div>

<style>
    .error-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .error-content {
        text-align: center;
        max-width: 500px;
    }

    .error-icon {
        font-size: 5rem;
        color: #ef4444;
        margin-bottom: 1.5rem;
    }

    .error-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1rem;
    }

    .error-message {
        color: #64748b;
        margin-bottom: 2rem;
    }
</style>
