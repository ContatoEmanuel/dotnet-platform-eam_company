@{
    ViewData["Title"] = "Blog";
    var posts = ViewBag.Posts;
}

<!-- Blog Header Section -->
<section class="pt-24 pb-12 bg-gradient-to-br from-blue-600 to-indigo-700 dark:from-blue-800 dark:to-indigo-900">
    <div class="container mx-auto px-4">
        <div class="text-center text-white">
            <h1 class="text-5xl font-bold mb-4 animate-fade-in dark:text-white">Blog</h1>
            <p class="text-xl text-blue-100 max-w-2xl mx-auto animate-fade-in dark:text-blue-200">
                Artigos sobre Dynamics 365, Power Platform, .NET e tecnologias Microsoft
            </p>
        </div>
    </div>
</section>

<!-- Filters Section -->
<section class="py-8 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700">
    <div class="container mx-auto px-4">
        <!-- Category Filter -->
        <div class="mb-6">
            <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Filtrar por Categoria:</h3>
            <div class="flex flex-wrap gap-2">
                <button class="category-filter px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-blue-600 text-white dark:bg-blue-500" data-category="all">
                    Todas
                </button>
                <button class="category-filter px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600" data-category=".NET">
                    .NET
                </button>
                <button class="category-filter px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600" data-category="Dynamics 365">
                    Dynamics 365
                </button>
                <button class="category-filter px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600" data-category="Power Platform">
                    Power Platform
                </button>
            </div>
        </div>

        <!-- Tags Filter -->
        <div>
            <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Filtrar por Tag:</h3>
            <div class="flex flex-wrap gap-2">
                <button class="tag-filter px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-200 bg-blue-50 dark:bg-blue-900 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-700 hover:bg-blue-100 dark:hover:bg-blue-800" data-tag="all">
                    Todas
                </button>
                @foreach (var tag in new[] { ".NET", "Automação", "Boas Práticas", "Clean Architecture", "CRM", "Design Patterns", "Dynamics 365", "Low-Code", "Microsoft", "Power Automate", "Power Platform", "Tutorial" })
                {
                    <button class="tag-filter px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-200 bg-gray-50 dark:bg-gray-700 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-600" data-tag="@tag">
                        @tag
                    </button>
                }
            </div>
        </div>
    </div>
</section>

<!-- Blog Posts Grid -->
<section class="py-16 bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4">
        <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var post in posts)
            {
                var postTags = post.Tags != null ? string.Join(",", post.Tags) : "";
                
                <article class="blog-post bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300 dark:border dark:border-gray-700" 
                         data-category="@(post.Category?.Name ?? "Geral")" 
                         data-tags="@postTags">
                    <!-- Post Image -->
                    <div class="aspect-video bg-gradient-to-br from-blue-500 to-indigo-600 relative overflow-hidden">
                        @if (!string.IsNullOrEmpty(post.ImageUrl))
                        {
                            <img src="@post.ImageUrl" alt="@post.Title" class="w-full h-full object-cover">
                        }
                        <div class="absolute top-4 left-4">
                            <span class="px-3 py-1 bg-white text-xs font-semibold rounded-full" style="background-color: white; color: @(post.Category?.Color ?? "#3B82F6");">
                                @(post.Category?.Name ?? "Geral")
                            </span>
                        </div>
                    </div>
                    
                    <!-- Post Content -->
                    <div class="p-6">
                        <!-- Meta Info -->
                        <div class="flex items-center text-sm text-gray-500 dark:text-gray-400 mb-3">
                            <i class="bi bi-calendar3 mr-2"></i>
                            <span>@(post.PublishedAt?.ToString("dd/MM/yyyy") ?? DateTime.Now.ToString("dd/MM/yyyy"))</span>
                            <span class="mx-2">•</span>
                            <i class="bi bi-clock mr-2"></i>
                            <span>@post.ReadTimeMinutes min</span>
                        </div>
                        
                        <!-- Title -->
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-3 line-clamp-2 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                            <a asp-controller="Blog" asp-action="Post" asp-route-id="@post.Id" asp-route-slug="@post.Slug">
                                @post.Title
                            </a>
                        </h2>
                        
                        <!-- Excerpt -->
                        <p class="text-gray-600 dark:text-gray-300 mb-4 line-clamp-3">
                            @post.Excerpt
                        </p>
                        
                        <!-- Author & Read More -->
                        <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-gray-700">
                            <div class="flex items-center">
                                <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-indigo-600 dark:from-blue-600 dark:to-indigo-700 rounded-full flex items-center justify-center text-white text-xs font-bold">
                                    EM
                                </div>
                                <span class="ml-2 text-sm text-gray-700 dark:text-gray-300 font-medium">@post.Author</span>
                            </div>
                            <a asp-controller="Blog" asp-action="Post" asp-route-id="@post.Id" asp-route-slug="@post.Slug" 
                               class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium text-sm flex items-center group">
                                Ler mais
                                <i class="bi bi-arrow-right ml-1 group-hover:translate-x-1 transition-transform"></i>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white dark:bg-gray-800">
    <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Quer aprender mais?</h2>
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
            Acompanhe meu trabalho e conecte-se comigo nas redes sociais para receber as últimas atualizações
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
            <a href="https://www.linkedin.com/in/emanuel-a-macedo/" target="_blank" 
               class="px-6 py-3 bg-blue-600 dark:bg-blue-500 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors duration-200 font-medium inline-flex items-center">
                <i class="bi bi-linkedin mr-2"></i> LinkedIn
            </a>
            <a href="https://github.com/ContatoEmanuel" target="_blank" 
               class="px-6 py-3 bg-gray-900 dark:bg-gray-700 text-white rounded-lg hover:bg-gray-800 dark:hover:bg-gray-600 transition-colors duration-200 font-medium inline-flex items-center">
                <i class="bi bi-github mr-2"></i> GitHub
            </a>
            <a href="https://www.youtube.com/channel/UCQbZlecPawGlx0F6Oo56LDw" target="_blank" 
               class="px-6 py-3 bg-red-600 dark:bg-red-500 text-white rounded-lg hover:bg-red-700 dark:hover:bg-red-600 transition-colors duration-200 font-medium inline-flex items-center">
                <i class="bi bi-youtube mr-2"></i> YouTube
            </a>
        </div>
    </div>
</section>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Read URL parameters
        const urlParams = new URLSearchParams(window.location.search);
        let activeCategory = urlParams.get('category') || 'all';
        let activeTag = urlParams.get('tag') || 'all';

        const categoryButtons = document.querySelectorAll('.category-filter');
        const tagButtons = document.querySelectorAll('.tag-filter');
        const posts = document.querySelectorAll('.blog-post');

        function filterPosts() {
            posts.forEach(post => {
                const postCategory = post.dataset.category;
                const postTags = post.dataset.tags.split(',').map(t => t.trim());
                
                const categoryMatch = activeCategory === 'all' || postCategory === activeCategory;
                const tagMatch = activeTag === 'all' || postTags.includes(activeTag);
                
                if (categoryMatch && tagMatch) {
                    post.style.display = 'block';
                } else {
                    post.style.display = 'none';
                }
            });
        }

        categoryButtons.forEach(button => {
            button.addEventListener('click', function() {
                activeCategory = this.dataset.category;
                
                // Update button styles
                categoryButtons.forEach(btn => {
                    if (btn === this) {
                        btn.classList.remove('bg-gray-100', 'text-gray-700', 'hover:bg-gray-200');
                        btn.classList.add('bg-blue-600', 'text-white');
                    } else {
                        btn.classList.remove('bg-blue-600', 'text-white');
                        btn.classList.add('bg-gray-100', 'text-gray-700', 'hover:bg-gray-200');
                    }
                });
                
                filterPosts();
            });
        });

        tagButtons.forEach(button => {
            button.addEventListener('click', function() {
                activeTag = this.dataset.tag;
                
                // Update button styles
                tagButtons.forEach(btn => {
                    if (btn === this) {
                        btn.classList.remove('bg-gray-50', 'text-gray-600', 'border-gray-200', 'hover:bg-gray-100');
                        btn.classList.add('bg-blue-600', 'text-white', 'border-blue-600');
                    } else {
                        btn.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
                        btn.classList.add('bg-gray-50', 'text-gray-600', 'border-gray-200', 'hover:bg-gray-100');
                    }
                });
                
                filterPosts();
            });
        });

        // Apply initial filter from URL
        if (activeCategory !== 'all') {
            categoryButtons.forEach(btn => {
                if (btn.dataset.category === activeCategory) {
                    btn.classList.remove('bg-gray-100', 'text-gray-700', 'hover:bg-gray-200');
                    btn.classList.add('bg-blue-600', 'text-white');
                } else if (btn.dataset.category !== 'all') {
                    btn.classList.remove('bg-blue-600', 'text-white');
                    btn.classList.add('bg-gray-100', 'text-gray-700', 'hover:bg-gray-200');
                }
            });
        }

        if (activeTag !== 'all') {
            tagButtons.forEach(btn => {
                if (btn.dataset.tag === activeTag) {
                    btn.classList.remove('bg-gray-50', 'text-gray-600', 'border-gray-200', 'hover:bg-gray-100');
                    btn.classList.add('bg-blue-600', 'text-white', 'border-blue-600');
                } else if (btn.dataset.tag !== 'all') {
                    btn.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
                    btn.classList.add('bg-gray-50', 'text-gray-600', 'border-gray-200', 'hover:bg-gray-100');
                }
            });
        }

        // Apply initial filter
        filterPosts();
    });
</script>
}

