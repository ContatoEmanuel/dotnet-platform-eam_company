@using EAM.Core.Application.DTOs.Project
@{
    ViewData["Title"] = "Início";
    var featuredProjects = ViewBag.FeaturedProjects as IEnumerable<ProjectDto> ?? Enumerable.Empty<ProjectDto>();
    var otherProjects = ViewBag.OtherProjects as IEnumerable<ProjectDto> ?? Enumerable.Empty<ProjectDto>();
}

<!-- Hero Section -->
<section id="hero" class="min-vh-100 d-flex align-items-center" style="background: linear-gradient(135deg, #EFF6FF 0%, #E0E7FF 100%); padding-top: 80px;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12 text-center">
                <!-- Profile Image -->
                <div class="mb-4 animate-fade-in">
                    <div class="d-inline-block position-relative">
                        <div class="profile-image-placeholder rounded-circle bg-gradient d-inline-flex align-items-center justify-content-center border border-4 border-white shadow-lg" 
                             style="width: 192px; height: 192px; background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);">
                            <span class="display-3 fw-bold text-white">EM</span>
                        </div>
                    </div>
                </div>

                <!-- Badge -->
                <div class="mb-3 animate-fade-in">
                    <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                        🚀 Disponível para novos projetos
                    </span>
                </div>

                <!-- Heading -->
                <h1 class="display-3 fw-bold mb-3 animate-fade-in">
                    Emanuel A Macêdo
                </h1>
                <h2 class="display-6 text-primary mb-4 animate-fade-in">
                    Senior Software Engineer
                </h2>
                <p class="lead text-muted mb-4 animate-fade-in">
                    Dynamics 365 • Power Platform • .NET C# • Azure
                </p>

                <!-- Social Links -->
                <div class="d-flex flex-wrap gap-2 justify-content-center mb-4 animate-fade-in">
                    <a href="https://linktr.ee/emanuel.macedo" target="_blank" class="btn btn-success">
                        <i class="bi bi-link-45deg"></i> Linktree
                    </a>
                    <a href="https://www.linkedin.com/in/emanuel-a-macedo/" target="_blank" class="btn btn-primary">
                        <i class="bi bi-linkedin"></i> LinkedIn
                    </a>
                    <a href="https://github.com/ContatoEmanuel" target="_blank" class="btn btn-dark">
                        <i class="bi bi-github"></i> GitHub
                    </a>
                    <a href="https://www.youtube.com/channel/UCQbZlecPawGlx0F6Oo56LDw" target="_blank" class="btn btn-danger">
                        <i class="bi bi-youtube"></i> YouTube
                    </a>
                    <a href="https://www.credly.com/users/emanuel-a-macedo/badges" target="_blank" class="btn btn-warning text-dark">
                        <i class="bi bi-award"></i> Credly
                    </a>
                    <a href="https://learn.microsoft.com/pt-br/users/emanuelarrudasmacedo-1105/" target="_blank" class="btn btn-info text-white">
                        <i class="bi bi-microsoft"></i> MS Learn
                    </a>
                </div>

                <!-- CTA Buttons -->
                <div class="d-flex flex-wrap gap-3 justify-content-center animate-fade-in">
                    <a href="#about" class="btn btn-primary btn-lg px-5 smooth-scroll">
                        Conheça mais
                    </a>
                    <a href="/resume.html" target="_blank" class="btn btn-outline-primary btn-lg px-5">
                        Download CV
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section id="about" class="py-5 bg-white">
    <div class="container py-5">
        <h2 class="text-center display-5 fw-bold mb-5">Sobre Mim</h2>
        
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <p class="lead text-center text-muted mb-3">
                    Engenheiro de Software Sênior especializado no ecossistema Microsoft, com sólida trajetória 
                    no desenvolvimento e sustentação de soluções críticas para grandes players dos setores 
                    <strong>financeiro, varejista e educacional</strong> (como Itaú, Bradesco Seguros, Alesat e Cogna).
                </p>
                <p class="text-center text-muted mb-5">
                    Minha expertise combina o desenvolvimento técnico avançado (Pro-Code) com a agilidade da 
                    Power Platform, permitindo-me atuar desde a arquitetura de soluções em nuvem até a 
                    manutenção de ambientes legados complexos (On-Premise).
                </p>
            </div>
        </div>

        <!-- Principais Clientes -->
        <div class="row mb-5">
            <div class="col-lg-10 mx-auto">
                <h3 class="text-center h4 mb-4">Experiência com Grandes Players</h3>
                <div class="row g-3">
                    @foreach (var client in new[] { 
                        new { Name = "Itaú", Sector = "Financeiro", Target = "exp-itau" },
                        new { Name = "Bradesco Seguros", Sector = "Seguros", Target = "exp-bradesco" },
                        new { Name = "Alesat", Sector = "Varejo", Target = "exp-alesat" },
                        new { Name = "Cogna", Sector = "Educação", Target = "exp-cogna" }
                    })
                    {
                        <div class="col-6 col-md-3">
                            <a href="#@client.Target" class="text-decoration-none client-card-link">
                                <div class="card h-100 shadow-sm hover-card" style="border: 2px solid #E5E7EB; cursor: pointer; transition: all 0.3s;">
                                    <div class="card-body text-center" style="background: linear-gradient(135deg, #F9FAFB 0%, #F3F4F6 100%);">
                                        <h5 class="card-title fw-bold mb-1 text-dark">@client.Name</h5>
                                        <p class="card-text small text-muted mb-0">@client.Sector</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Expertise -->
        <div class="row mb-5">
            <div class="col-lg-10 mx-auto">
                <h3 class="text-center h4 mb-4">Principais Competências</h3>
                <div class="row g-4">
                    @foreach (var expertise in new[] {
                        new { Icon = "⚙️", Title = "Desenvolvimento Dynamics 365", Description = "Domínio na customização e extensão da plataforma (Sales, Customer Service) utilizando C# .NET para Plugins e Workflows, além de JavaScript para scripts client-side e validações complexas." },
                        new { Icon = "⚡", Title = "Power Platform & Mobilidade", Description = "Criação de aplicações de negócio robustas com Power Apps (Canvas com capacidade offline e Model-Driven) e automação avançada de processos via Power Automate." },
                        new { Icon = "☁️", Title = "Integração & Azure", Description = "Experiência na orquestração de dados e processos entre sistemas heterogêneos utilizando Azure Logic Apps, Data Factory e consumo de APIs REST/SOAP." },
                        new { Icon = "🔒", Title = "Dados & Segurança", Description = "Modelagem de dados no Dataverse, criação de dashboards em Power BI e gestão granular de perfis de segurança e acessos." },
                        new { Icon = "🎯", Title = "Metodologia Ágil", Description = "Atuação consistente em ambientes ágeis (Scrum/Kanban), com foco em entregas de valor e melhoria contínua." }
                    })
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm hover-card">
                                <div class="card-body">
                                    <div class="d-flex align-items-start">
                                        <div class="fs-1 me-3">@expertise.Icon</div>
                                        <div>
                                            <h5 class="card-title fw-bold">@expertise.Title</h5>
                                            <p class="card-text text-muted small">@expertise.Description</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Tech Stack -->
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <h3 class="text-center h4 mb-4">Stack Tecnológico</h3>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    @foreach (var tech in new[] { 
                        "Microsoft Dynamics 365", "Microsoft Power Platform", "ASP.NET Core", "C# .NET", "JavaScript", 
                        "Azure Cloud", "Power Apps", "Power Automate", "Power BI", "Azure Logic Apps", 
                        "Data Factory", "Dataverse", "SQL Server", "TypeScript", "React", "Azure DevOps" 
                    })
                    {
                        <span class="badge px-3 py-2" style="background-color: #EFF6FF; color: #1E40AF; border: 1px solid #BFDBFE;">@tech</span>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Projects Section -->
<section id="projects" class="py-5 bg-light">
    <div class="container py-5">
        <h2 class="text-center display-5 fw-bold mb-3">Portfólio de Projetos</h2>
        <p class="text-center text-muted mb-5 col-lg-8 mx-auto">
            Soluções desenvolvidas utilizando o ecossistema Microsoft, focadas em integração, 
            automação e modernização de processos empresariais.
        </p>

        <div class="row g-4">
            @foreach (var project in featuredProjects)
            {
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-lg hover-card">
                        <div class="position-relative" style="background: linear-gradient(135deg, #DBEAFE 0%, #E0E7FF 100%); height: 200px; display: flex; align-items: center; justify-content: center;">
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-warning text-dark">⭐ Destaque</span>
                            </div>
                            <div class="fs-1">@project.IconEmoji</div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@project.Title</h5>
                            <p class="card-text text-muted small">
                                @project.Description
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @foreach (var tech in project.Technologies)
                                {
                                    <span class="badge bg-primary-subtle text-primary">@tech</span>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                @if (!string.IsNullOrEmpty(project.LiveUrl))
                                {
                                    <a href="@project.LiveUrl" target="_blank" class="btn btn-primary btn-sm">
                                        🔗 Ver Projeto
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(project.GithubUrl))
                                {
                                    <a href="@project.GithubUrl" target="_blank" class="btn btn-dark btn-sm">
                                        <i class="bi bi-github"></i> @(string.IsNullOrEmpty(project.LiveUrl) ? "Ver no GitHub" : "GitHub")
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Outros Projetos -->
        <h3 class="text-center h4 mt-5 mb-4">Outros Projetos</h3>
        <div class="row g-4">
            @foreach (var project in otherProjects)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow hover-card">
                        <div class="card-body text-center">
                            <div class="fs-1 mb-3">@project.IconEmoji</div>
                            <h6 class="card-title fw-bold">@project.Title</h6>
                            <p class="card-text small text-muted">
                                @project.Description
                            </p>
                            <div class="d-flex flex-wrap gap-1 justify-content-center mb-2">
                                @foreach (var tech in project.Technologies.Take(2))
                                {
                                    <span class="badge bg-secondary-subtle text-secondary small">@tech</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(project.GithubUrl))
                            {
                                <a href="@project.GithubUrl" target="_blank" class="btn btn-dark btn-sm mt-2">
                                    <i class="bi bi-github"></i> GitHub
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-4">
            <a href="https://github.com/ContatoEmanuel" target="_blank" class="btn btn-outline-primary">
                Ver todos os projetos no GitHub
            </a>
        </div>
    </div>
</section>

<!-- Experience Section -->
