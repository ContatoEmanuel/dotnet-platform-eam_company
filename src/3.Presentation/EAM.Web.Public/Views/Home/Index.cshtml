                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a href="/resume.html" target="_blank" class="btn btn-primary btn-lg px-5">
                            <i class="bi bi-download"></i> Download Currículo Completo
                        </a>
                        <a href="https://www.linkedin.com/in/emanuel-a-macedo/" target="_blank" class="btn btn-outline-primary btn-lg px-5">
