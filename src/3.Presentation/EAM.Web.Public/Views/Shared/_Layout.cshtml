<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="EAM Company - Emanuel A Macêdo | Senior Software Engineer especializado em Dynamics 365, Power Platform, .NET C# e Azure." />
    <meta name="keywords" content="Emanuel Macêdo, Dynamics 365, Power Platform, Software Engineer, .NET, Azure, Microsoft" />
    <meta name="author" content="Emanuel A Macêdo" />
    <meta name="robots" content="index, follow" />
    
    <title>@ViewData["Title"] - EAM Company</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico?v=2">
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico?v=2">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EAM.Web.Public.styles.css" asp-append-version="true" />
    
    <!-- Dark Mode Script - Inline to prevent flash -->
    <script>
        // Check for saved theme preference or default to light mode
        const theme = localStorage.getItem('theme') || 'light';
        if (theme === 'dark') {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 transition-colors duration-200">
    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden transition-opacity duration-300"></div>
    
    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 bg-white dark:bg-gray-800 shadow-md z-50 backdrop-blur-sm bg-opacity-95 dark:bg-opacity-95 transition-colors duration-200">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-between h-16">
                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="text-2xl font-bold text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition-colors">
                    EAM Company
                </a>

                <!-- Desktop Navigation -->
                <div class="flex items-center space-x-4">
                    <!-- Dark Mode Toggle -->
                    <button id="theme-toggle" type="button" class="p-2 rounded-md text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-600 transition-colors duration-200">
                        <span class="sr-only">Alternar tema</span>
                        <!-- Sun icon (shown in dark mode) -->
                        <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
                        </svg>
                        <!-- Moon icon (shown in light mode) -->
                        <svg id="theme-toggle-dark-icon" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                        </svg>
                    </button>

                    <!-- Hamburger Button - Always visible -->
                    <button id="hamburger-btn" type="button" class="inline-flex items-center justify-center p-2 rounded-md text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-600 transition-colors duration-200">
                        <span class="sr-only">Abrir menu</span>
                        <!-- Icon when menu is closed -->
                        <svg id="menu-icon-closed" class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <!-- Icon when menu is open -->
                        <svg id="menu-icon-open" class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>

                    <!-- Blog Link -->
                    <a asp-controller="Blog" asp-action="Index" class="nav-link-desktop" id="blog-link" target="_blank">
                        <i class="bi bi-journal-text me-1"></i>
                        Blog
                    </a>
                    
                    <!-- Portal Button -->
                    <a href="@(ViewBag.AppSettings?.PortalUrl ?? "http://localhost:5002")" target="_blank" 
                       class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors duration-200 font-medium inline-flex items-center">
                        <i class="bi bi-box-arrow-up-right me-2"></i>
                        Portal do Cliente
                    </a>
                </div>
            </div>
        </div>

        <!-- Sidebar Menu - Slide from right -->
        <div id="mobile-menu" class="fixed top-0 right-0 bottom-0 w-80 bg-white dark:bg-gray-800 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-50">
            <div class="flex flex-col h-full">
                <!-- Mobile Menu Header -->
                <div class="flex items-center justify-between p-4 border-b dark:border-gray-700">
                    <span class="text-xl font-bold text-blue-600 dark:text-blue-400">Menu</span>
                    <button id="close-menu-btn" type="button" class="p-2 rounded-md text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-gray-100 dark:hover:bg-gray-700">
                        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                
                <!-- Mobile Menu Items -->
                <div class="flex-1 overflow-y-auto py-4">
                    <a class="mobile-menu-item" href="#hero">
                        <i class="bi bi-house-door"></i>
                        <span>Início</span>
                    </a>
                    <a class="mobile-menu-item" href="#about">
                        <i class="bi bi-person"></i>
                        <span>Sobre</span>
                    </a>
                    <a class="mobile-menu-item" href="#projects">
                        <i class="bi bi-briefcase"></i>
                        <span>Projetos</span>
                    </a>
                    <a class="mobile-menu-item" href="#experience">
                        <i class="bi bi-award"></i>
                        <span>Experiência</span>
                    </a>
                    <a class="mobile-menu-item" href="#contact">
                        <i class="bi bi-envelope"></i>
                        <span>Contato</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark dark:bg-gray-950 text-light py-4 mt-5 transition-colors duration-200">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="fw-bold">@(ViewBag.AppSettings?.CompanyName ?? "EAM Company")</h5>
                    <p class="text-light opacity-75 small">Soluções Microsoft para grandes empresas</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="mb-3">
                        <a href="@(ViewBag.AppSettings?.SocialMedia?.LinkedIn ?? "https://www.linkedin.com/in/emanuel-a-macedo/")" target="_blank" class="text-light me-3 social-link">
                            <i class="bi bi-linkedin fs-4"></i>
                        </a>
                        <a href="@(ViewBag.AppSettings?.SocialMedia?.GitHub ?? "https://github.com/ContatoEmanuel")" target="_blank" class="text-light me-3 social-link">
                            <i class="bi bi-github fs-4"></i>
                        </a>
                        <a href="@(ViewBag.AppSettings?.SocialMedia?.YouTube ?? "https://www.youtube.com/channel/UCQbZlecPawGlx0F6Oo56LDw")" target="_blank" class="text-light social-link">
                            <i class="bi bi-youtube fs-4"></i>
                        </a>
                    </div>
                    <p class="text-light opacity-75 small mb-0">&copy; @DateTime.Now.Year @(ViewBag.AppSettings?.CompanyName ?? "EAM Company") - Todos os direitos reservados</p>
                    <p class="text-light opacity-75 small">
                        Desenvolvido com ASP.NET Core, TypeScript, Tailwind CSS, Vite, Docker &amp; Clean Architecture
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Back to Top Button -->
    <button id="backToTop" class="btn btn-primary back-to-top" style="display: none;">
        <i class="bi bi-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- TypeScript compilado -->
    <script type="module" src="~/js/app.js" asp-append-version="true"></script>
    
    <!-- Blog link behavior -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const blogLink = document.getElementById('blog-link');
            
            if (blogLink) {
                // Se já estiver na página de blog, remove o target
                if (window.location.pathname.toLowerCase().includes('/blog')) {
                    blogLink.removeAttribute('target');
                }
                
                // Adiciona evento de click para verificar em tempo real
                blogLink.addEventListener('click', function(e) {
                    if (window.location.pathname.toLowerCase().includes('/blog')) {
                        this.removeAttribute('target');
                    }
                });
            }
        });
    </script>
    
    <!-- Dark Mode Toggle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const themeToggleBtn = document.getElementById('theme-toggle');
            const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
            const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
            
            // Check current theme and set icons
            function updateIcons() {
                if (document.documentElement.classList.contains('dark')) {
                    themeToggleLightIcon.classList.remove('hidden');
                    themeToggleDarkIcon.classList.add('hidden');
                } else {
                    themeToggleDarkIcon.classList.remove('hidden');
                    themeToggleLightIcon.classList.add('hidden');
                }
            }
            
            updateIcons();
            
            // Toggle theme
            themeToggleBtn.addEventListener('click', function() {
                document.documentElement.classList.toggle('dark');
                
                // Save preference to localStorage
                if (document.documentElement.classList.contains('dark')) {
                    localStorage.setItem('theme', 'dark');
                } else {
                    localStorage.setItem('theme', 'light');
                }
                
                updateIcons();
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
