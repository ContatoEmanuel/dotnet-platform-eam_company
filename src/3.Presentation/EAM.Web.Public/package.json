{
  "name": "eam-web-public",
  "version": "1.0.0",
  "description": "EAM Company - Site Institucional com TypeScript",
  "scripts": {
    "build:ts": "tsc",
    "watch:ts": "tsc --watch",
    "build:css": "tailwindcss -i ./wwwroot/css/tailwind.css -o ./wwwroot/css/site.css --minify",
    "watch:css": "tailwindcss -i ./wwwroot/css/tailwind.css -o ./wwwroot/css/site.css --watch",
    "build": "npm run build:ts && npm run build:css",
    "watch": "npm run watch:ts & npm run watch:css",
    "build:prod": "npm run build && npm run minify",
    "minify": "terser wwwroot/js/app.js -o wwwroot/js/app.min.js --compress --mangle"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.10",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "terser": "^5.36.0",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "typescript",
    "aspnet",
    "bootstrap"
  ],
  "author": "Emanuel A Macêdo",
  "license": "MIT"
}
