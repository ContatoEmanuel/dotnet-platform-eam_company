# ==============================================
# EAM Platform - Environment Variables Template
# ==============================================
# Copie este arquivo para .env e ajuste os valores conforme necessário
# IMPORTANTE: Nunca commite o arquivo .env no repositório!

# ----------------------------------------------
# Database Configuration
# ----------------------------------------------
DB_NAME=EAM_Database
DB_PASSWORD=YourStrong@Password123

# ----------------------------------------------
# Environment
# ----------------------------------------------
# Values: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# ----------------------------------------------
# URLs (Produção - Configure para seus domínios)
# ----------------------------------------------
PORTAL_URL=http://localhost:5002
PUBLIC_WEBSITE_URL=http://localhost:5001

# ----------------------------------------------
# Company Information
# ----------------------------------------------
COMPANY_NAME=EAM Company
AUTHOR_NAME=Emanuel Macêdo

# ----------------------------------------------
# JWT Settings (API Authentication)
# ----------------------------------------------
# ATENÇÃO: Use uma chave forte em produção (mínimo 32 caracteres)
JWT_SECRET_KEY=YourSuperSecretKeyForJWT_ChangeThisInProduction_MinimumLength32Characters!
JWT_ISSUER=EAM.Web.API
JWT_AUDIENCE=EAM.Clients
JWT_EXPIRATION_HOURS=24

# ----------------------------------------------
# Social Media URLs (Configure com suas redes)
# ----------------------------------------------
SOCIAL_LINKEDIN=https://www.linkedin.com/in/emanuel-a-macedo/
SOCIAL_GITHUB=https://github.com/ContatoEmanuel
SOCIAL_YOUTUBE=https://www.youtube.com/channel/UCQbZlecPawGlx0F6Oo56LDw
SOCIAL_LINKTREE=https://linktr.ee/emanuel.macedo
SOCIAL_CREDLY=https://www.credly.com/users/emanuel-a-macedo/badges
SOCIAL_MSLEARN=https://learn.microsoft.com/pt-br/users/emanuelarrudasmacedo-1105/
SOCIAL_WHATSAPP=https://wa.me/5538988601152
