{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (API)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/3.Presentation/EAM.Web.API/bin/Debug/net10.0/EAM.Web.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/3.Presentation/EAM.Web.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": ".NET Core Launch (MVC Public)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-public",
      "program": "${workspaceFolder}/src/3.Presentation/EAM.Web.Public/bin/Debug/net10.0/EAM.Web.Public.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/3.Presentation/EAM.Web.Public",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": ".NET Core Launch (Blazor Portal)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-portal",
      "program": "${workspaceFolder}/src/3.Presentation/EAM.Web.Portal/bin/Debug/net10.0/EAM.Web.Portal.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/3.Presentation/EAM.Web.Portal",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Docker: All Services",
      "type": "docker",
      "request": "launch",
      "preLaunchTask": "docker-compose-up",
      "platform": "netCore"
    }
  ],
  "compounds": [
    {
      "name": "All .NET Apps",
      "configurations": [
        ".NET Core Launch (API)",
        ".NET Core Launch (MVC Public)",
        ".NET Core Launch (Blazor Portal)"
      ]
    }
  ]
}
